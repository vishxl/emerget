{
  "manifest_version": 3,
  "name": "Emerget — Export Emergent Chat History",
  "version": "1.3.0",
  "description": "Export your complete Emergent.sh chat history in one click. Ordered, expandable, faithful to the original conversation — Markdown, TXT, JSON or resume prompt.",
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": ["*://app.emergent.sh/*"],
  "content_scripts": [
    {
      "matches": ["*://app.emergent.sh/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://app.emergent.sh/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Emerget — Export Emergent Chat History"
  }
}
